PORT=3000
# Optional comma-separated trusted proxy IPs/subnets, never arbitrary client headers.
TRUST_PROXY=""

# Server-only Stripe test keys. Never prefix secrets with VITE_.
# Missing keys allow startup but payment creation returns 503.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Public Stripe key, embedded by Vite at build time. Must match secret key mode/account.
VITE_STRIPE_PUBLISHABLE_KEY=""

# npm run dev: Express + Vite middleware on PORT (default 3000).
# npm run build && npm start: single production server serving dist + /api.
# Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook
# Webhooks verify signatures and acknowledge only: no storage or fulfillment.
# Rate limits are process-local (20 creation requests/IP/minute), not order storage.
# Forwarded IP headers are not trusted unless TRUST_PROXY is configured for your
# deployment. Otherwise customers behind one proxy share the same rate limit.
# Retry unchanged checkout requests with the same UUID attemptId; explicit edits
# need a new UUID. Stripe idempotency retention is finite (at least 24 hours),
# so do not automatically replay old attempts after that window.
